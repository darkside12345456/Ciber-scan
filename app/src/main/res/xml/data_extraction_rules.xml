<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- A chave da API do Claude nunca é incluída em backups para a cloud. -->
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />
        <exclude domain="sharedpref" path="ai_prefs_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Nem em transferências dispositivo-a-dispositivo. -->
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />
        <exclude domain="sharedpref" path="ai_prefs_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
