<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      QUERY_ALL_PACKAGES é uma permissão sensível (Android 11+ / API 30).
      Na submissão à Play Store tens de justificar o caso de uso "segurança/
      antivírus" no formulário de permissões. Sem justificação aprovada a app
      é rejeitada. Ver relatório técnico, secções 2 e 6.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Necessária para as notificações de monitorização (premium) em Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      INTERNET é usada APENAS pelo assistente de redação com IA (opcional e
      desativado por omissão). Todo o resto da app é 100% local. Ao ativar a IA,
      o texto do relatório é enviado para a API do Claude com a chave do próprio
      utilizador. Declarar isto na secção Data safety da Play Store.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PrivacyScannerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrivacyScanner"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PrivacyScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partilha segura dos PDF de relatório gerados localmente. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
