<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET é usada apenas pelo assistente de redação com IA (opcional,
      desligado por omissão). Ao ativar, o texto do relatório é enviado para a
      API do Claude com a chave do próprio utilizador. Esta app NÃO usa
      QUERY_ALL_PACKAGES — não precisa de ver outras apps.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BountyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrivacyScanner"
        tools:targetApi="34">

        <activity
            android:name=".BountyMainActivity"
            android:exported="true"
            android:theme="@style/Theme.PrivacyScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partilha segura dos PDF de relatório gerados localmente. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
